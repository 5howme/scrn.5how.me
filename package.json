{
	"name": "me.5how.scrn",
	"private": true,
	"version": "0.6.49",
	"type": "module",
	"packageManager": "npm@10.9.4",
	"engines": {
		"node": "22.22.1",
		"npm": "10.9.4"
	},
	"author": {
		"name": "5how.me",
		"url": "https://scrn.5how.me"
	},
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite",
		"vrsn": "node scripts/sync-vrsn.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"i18n:check": "node scripts/i18n-check.mjs",
		"build:native:win": "node scripts/build-windows-wgc-helper.mjs",
		"build:native:mac": "node scripts/build-macos-screencapturekit-helper.mjs",
		"build:win": "npm run vrsn && vite build && electron-builder --win --config.npmRebuild=false",
		"build:mac": "npm run build:native:mac && npm run vrsn && vite build && electron-builder --mac",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e:windows-native-checklist": "playwright test tests/e2e/windows-native-checklist.spec.ts",
		"test:cursor-native:win": "node scripts/test-windows-native-cursor.mjs",
		"test:wgc-helper:win": "node scripts/test-windows-wgc-helper.mjs",
		"diagnostic:run": "node scripts/diagnostic-tool/diagnostic.mjs"
	},
	"dependencies": {
		"@fix-webm-duration/fix": "^1.0.1",
		"@fix-webm-duration/parser": "^1.0.1",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tiptap/extension-text-style": "^3.30.2",
		"@tiptap/react": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fix-webm-duration": "^1.0.6",
		"lucide-react": "^0.545.0",
		"motion": "^12.38.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.6.0",
		"react-resizable-panels": "^3.0.6",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@biomejs/biome": "^2.4.12",
		"@electron/rebuild": "^4.0.4",
		"@playwright/test": "^1.59.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.19.17",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.5.0",
		"electron": "^41.2.1",
		"electron-builder": "^26.8.1",
		"esbuild": "^0.27.0",
		"fast-check": "^4.7.0",
		"jsdom": "^29.0.2",
		"postcss": "^8.5.10",
		"tailwindcss": "^3.4.19",
		"terser": "^5.46.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^1.0.0",
		"vitest": "^4.1.4"
	},
	"description": "Screen Recorder for scrn.5how.me"
}
